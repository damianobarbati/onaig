{
  "name": "onaig",
  "version": "1.0.0",
  "private": true,
  "author": "Damiano Barbati <damiano.barbati@gmail.com> (https://github.com/damianobarbati)",
  "repository": "https://github.com/damianobarbati/onaig",
  "description": "Giano - reversed. Passkey authentication for the blockchain.",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "pnpm": ">=12.5",
    "node": ">=26.7"
  },
  "type": "module",
  "scripts": {
    "postinstall": "pnpm audit --audit-level critical",
    "lint": "biome check --write",
    "tsc": "tsc",
    "env:up": "docker compose up -d --wait --quiet-pull --remove-orphans",
    "env:down": "docker compose down --volumes",
    "predev": "lsof -t -i:8080 -i:3000 | xargs kill -9",
    "dev": "concurrently \"pnpm -F poc api\" \"pnpm -F poc web\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
